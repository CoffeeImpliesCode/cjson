// SPDX-License-Identifier: MIT
.{
    // Package, module, and artifact name.
    .name = .cjson,
    // Upstream cJSON release; build.zig checks this version against the header.
    .version = "1.7.19",
    // Fingerprint derivation is recorded in UPSTREAM.md.
    .fingerprint = 0x52f300d9c8f9dfce,
    .minimum_zig_version = "0.16.0",
    // All dependencies are vendored; none are fetched.
    .dependencies = .{},
    .paths = .{
        "build.zig",
        "build.zig.zon",
        // cross-test profile for the package.
        "cross-test.profile.sh",
        // Zig facade and aggregate translation header.
        "zig",
        // Complete, unmodified upstream cJSON release tree.
        "src",
        // Fixture corpus used by the test suite.
        "testdata",
        "tests.zig",
        "smoke.zig",
        // Separate dependent package.
        "consumer/build.zig",
        "consumer/build.zig.zon",
        "consumer/src/main.zig",
        // Upstream README and fork records.
        "README.upstream.md",
        "UPSTREAM.md",
        "UPSTREAM.sha256",
        "README.md",
        "README.zig.md",
        "NOTICE.md",
        "CHANGELOG.md",
        "FORK-NOTES.md",
        "FORK-LICENSE.md",
        // Provenance tools.
        "tools",
        // Runtime loader modules.
        "runtime",
        // Nix packaging and development-shell files.
        "package.nix",
        "flake.nix",
        "devenv.nix",
        "devenv.yaml",
        ".envrc",
    },
}
